# =============================================================================
# APAARSetu Backend Configuration Template
# Problem Statement: SIH 2026 — PS 26263 (AICTE Regulation Bureau)
#
# INSTRUCTIONS:
# 1. Copy this file to `backend/.env`.
# 2. Populate with your specific Supabase credentials and security keys.
# 3. NEVER commit your actual `.env` file to version control.
# =============================================================================

# 1. Supabase PostgreSQL Connection String
# Use the connection pooler on port 6543 for transaction pooling
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# 2. Application Runtime Environment
ENVIRONMENT=development
TESTING=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Automatically permits all preview and production deployments under vercel.app
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# 3. Batch CSV Ingestion Constraints
MAX_UPLOAD_SIZE_BYTES=5242880
MAX_UPLOAD_ROWS=10000

# 4. Field-Level Cryptographic Protection (AES-256-GCM & Blind Index HMAC-SHA-256)
# Generate 64 hex characters (32 random bytes) using: python -c "import secrets; print(secrets.token_hex(32))"
AES_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
HMAC_SEARCH_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# 5. Supabase Auth Authority & Cryptographic JWT Verification
SUPABASE_PROJECT_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET
SUPABASE_JWT_AUDIENCE=authenticated
