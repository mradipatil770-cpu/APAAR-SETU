# APAARSetu Frontend Configuration Template
# Copy this file to .env or .env.local

# URL of the backend FastAPI service
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional Supabase public variables (FOR BROWSER AUTH ONLY)
# NEVER put service_role keys, database URLs, or secret passwords here!
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

