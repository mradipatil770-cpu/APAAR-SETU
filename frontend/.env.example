# =============================================================================
# APAARSetu Frontend Configuration Template
# Problem Statement: SIH 2026 — PS 26263 (AICTE Regulation Bureau)
#
# INSTRUCTIONS:
# 1. Copy this file to `frontend/.env` or `frontend/.env.local`.
# 2. Populate with your FastAPI backend URL and public Supabase project keys.
# 3. DO NOT include database passwords or secret signing keys here.
# =============================================================================

# 1. URL of the backend FastAPI service
# Local development: http://127.0.0.1:8000
# Vercel production: https://your-backend-app.onrender.com (replace with your Render backend URL)
VITE_API_BASE_URL=http://127.0.0.1:8000

# 2. Supabase Public Browser Configuration
# Used strictly for client-side authentication handshakes and session restoration.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
